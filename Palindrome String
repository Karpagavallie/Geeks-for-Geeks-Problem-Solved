class Solution {
    boolean isPalindrome(String s) {
        // code here
        int left=0;
        int right=s.length()-1;
        while(left<=right)
        {
            if(s.charAt(right)!=s.charAt(left))
            {
                return false;
            }
            left++;
            right--;
        }
        return true;
    }
}
