class Solution {
    int maxSubarraySum(int[] arr) {
        // Code here

        int current_sum=arr[0];
        int max=arr[0];
        for(int i=1;i<arr.length;i++)
        {
            
            current_sum=Math.max(arr[i],current_sum+arr[i]);
            max=Math.max(current_sum,max);
        }
        return max;
    }
}
