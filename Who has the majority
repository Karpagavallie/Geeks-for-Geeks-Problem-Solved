class Solution {
    public boolean isMajority(int[] arr) {
        // code here
        Map<Integer,Integer>map=new HashMap<>();
        for(int i=0;i<arr.length;i++)
        {
            map.put(arr[i],map.getOrDefault(arr[i],0)+1);
        }
        int m=arr.length/2;
        if(map.get(arr[m])>m)
        {
            return true;
        }
        return false;
    }
}
