class Solution {
    public int missingNumber(int[] arr) {
        // code here
      int n=arr.length;
      Set<Integer>set=new TreeSet<>();
      for(int i=0;i<n;i++)
      {
          set.add(arr[i]);
      }
      
      for(int i=1;i<=n;i++)
      {
          if(!set.contains(i))
          {
              return i;
          }
      }
      return n+1;
    }
}
