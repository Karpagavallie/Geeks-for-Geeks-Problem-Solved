class Solution {
    public static boolean checkPangram(String s) {
        // code here
        Set<Character>set=new HashSet<>();
        
        for(int i=0;i<s.length();i++)
        {
            if(Character.isLetter(s.charAt(i)))
            {
                char ch=Character.toLowerCase(s.charAt(i));
                 set.add(ch);
            }
        }
        if(set.size()==26)
        {
            return true;
        }
        return false;
    }
}
