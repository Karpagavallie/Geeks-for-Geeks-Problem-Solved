class Solution {
    public ArrayList<Integer> kLargest(int[] arr, int k) {
        // code here
        Arrays.sort(arr);
        ArrayList<Integer>list=new ArrayList<>();
        int s=0;
        for(int i=arr.length-1;i>=0;i--)
        {
            if(s==k)
            {
                break;
            }
            list.add(arr[i]);
            s++;
            
        }
        return list;
    }
}
